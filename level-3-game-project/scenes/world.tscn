english_information = "The Dance Room is used for dance classes, choreography, and performances where students develop creativity and teamwork."
japanese_title = "ダンスルーム"
japanese_information = "ダンスルームでは、ダンスの技術、振り付け、パフォーマンスを学びます。"

[node name="Gymnasium" parent="InfoPoints" unique_id=1670678464 instance=ExtResource("16_dss4m")]
