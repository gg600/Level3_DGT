english_title = "Library"
english_information = "The library is a quiet place for reading, studying, completing homework, and finding learning resources."
japanese_title = "図書館"
japanese_information = "図書館は読書、勉強、宿題、資料を探すための静かな学習スペースです。"

[node name="Canteen" parent="InfoPoints" unique_id=1186463243 instance=ExtResource("16_dss4m")]
transform = Transform3D(2.7787642, 0, -0.34419277, 0, 2.8, 0, 0.34419277, 0, 2.7787642, -606.24896, 18.21219, 505.24606)
explorer_id = "canteen"
english_title = "Canteen"
english_information = "The canteen sells food and drinks during interval and lunchtime."
japanese_title = "食堂"
japanese_information = "食堂では、休み時間や昼休みに食べ物や飲み物を購入できます。"

[node name="Whare" parent="InfoPoints" unique_id=385312839 instance=ExtResource("16_dss4m")]
transform = Transform3D(-1.1828883, 0, -2.5378683, 0, 2.8, 0, 2.5378683, 0, -1.1828883, -580.9943, 18.21219, 469.3652)
explorer_id = "whare_haoini_paora"
english_title = "Whare Hoani Paora"
english_information = "Whare Hoani Paora is a space for Māori culture, Te Reo Māori, Tikanga Māori, and connecting with whānau."
japanese_title = "ホアレ・ホアニ・パオラ"
japanese_information = "ホアレ・ホアニ・パオラは、マオリ文化、テ・レオ・マオリ、ティカンガ・マオリを学び、つながりを深める場所です。"

[node name="MainReception" parent="InfoPoints" unique_id=1240282767 instance=ExtResource("16_dss4m")]
transform = Transform3D(-2.6451685, 0, 0.91819537, 0, 2.8, 0, -0.91819537, 0, -2.6451685, -613.2616, 18.21219, 463.77148)
english_title = "Main Reception"
english_information = "Reception is the main welcome area of the school. Visit here if you are late, need help, have questions, or need assistance as a visitor."
japanese_title = "受付"
japanese_information = "受付は学校の入口にある場所です。遅刻した時や質問がある時、来校者の案内が必要な時に利用します。"

[node name="StudentReception" parent="InfoPoints" unique_id=1551247775 instance=ExtResource("16_dss4m")]
transform = Transform3D(2.649798, 0, -0.9047491, 0, 2.8000004, 0, 0.9047491, 0, 2.649798, -630.637, 18.21219, 499.02188)
explorer_id = "student_reception"
english_title = "Student Reception"
english_information = "Student Reception is a place where students can go for help, ask questions, and receive support with issues related to school life."
japanese_title = "生徒受付"
japanese_information = "生徒受付は、学校生活についての質問やサポートが必要な時に生徒が相談できる場所です。困ったことがある場合は、ここで助けを受けることができます。"

[node name="Careers" parent="InfoPoints" unique_id=1385674568 instance=ExtResource("16_dss4m")]
transform = Transform3D(-0.9284375, 0, -2.6415913, 0, 2.8000004, 0, 2.6415913, 0, -0.9284375, -631.233, 18.21219, 522.1557)
english_title = "Careers & Gateway"
english_information = "The Careers and Gateway office helps students explore future study options, careers, work experience, and pathways."
japanese_title = "進路・キャリア支援"
japanese_information = "進路支援では、大学、職業訓練、仕事体験、将来のキャリアについて相談することができます。"

[node name="LearningSupport" parent="InfoPoints" unique_id=417771737 instance=ExtResource("16_dss4m")]
transform = Transform3D(0.31993097, 0, -2.7816622, 0, 2.8000004, 0, 2.7816622, 0, 0.31993097, -645.1376, 18.21219, 563.42737)
english_title = "Wellbeing Centre"
english_information = "The Wellbeing Centre provides support for students through counselling, health services, and wellbeing assistance."
japanese_title = "生徒ウェルビーイングセンター"
japanese_information = "生徒ウェルビーイングセンターでは、カウンセラーや看護師から健康や生活についてのサポートを受けることができます。"

[node name="CookingRoom" parent="InfoPoints" unique_id=913325110 instance=ExtResource("16_dss4m")]
transform = Transform3D(-0.6256721, 0, 2.7292004, 0, 2.8000004, 0, -2.7292004, 0, -0.6256721, -658.47375, 18.21219, 571.90076)
explorer_id = "cooking_room"
english_title = "Cooking Room"
english_information = "The Cooking Room is used for Food Technology classes where students learn cooking and food preparation skills."
japanese_title = "調理室"
japanese_information = "調理室では、料理、食品準備、Food Technologyの授業を通して実践的なスキルを学びます。"

[node name="MusicSuite" parent="InfoPoints" unique_id=379850623 instance=ExtResource("16_dss4m")]
transform = Transform3D(-2.7652824, 0, -0.43956143, 0, 2.8000004, 0, 0.43956143, 0, -2.7652824, -454.9384, 19.877703, 277.29965)
explorer_id = "music_suite"
english_title = "Music Suite"
english_information = "The Music Suite is used for music lessons, instrument practice, rehearsals, and performances."
japanese_title = "音楽室"
japanese_information = "音楽室では、楽器の演奏、音楽の授業、リハーサルや発表の準備を行います。"

[node name="ThurstonTheatre" parent="InfoPoints" unique_id=2064145034 instance=ExtResource("16_dss4m")]
transform = Transform3D(2.7625377, 0, 0.4564934, 0, 2.8000007, 0, -0.4564934, 0, 2.7625377, -463.9049, 19.877703, 293.42627)
english_title = "Thurston Theatre"
english_information = "Thurston Theatre is a performance space used for drama productions, school shows, and creative events."
japanese_title = "サーストンシアター"
japanese_information = "サーストンシアターでは、演劇、学校公演、様々な創造的なイベントが行われます。"

[node name="DanceRoom" parent="InfoPoints" unique_id=1426673981 instance=ExtResource("16_dss4m")]
transform = Transform3D(0.61981213, 0, -2.7305372, 0, 2.8000007, 0, 2.7305372, 0, 0.61981213, -433.14368, 19.877703, 263.33228)
