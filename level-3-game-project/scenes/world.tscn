japanese_title = "アストロコート"
japanese_information = "アストロコートは人工芝の屋外コートです。体育の授業や部活動、ネットボールやテニスなどのスポーツに利用されます。"

[node name="CatholicChapel" parent="InfoPoints" unique_id=332931578 instance=ExtResource("16_dss4m")]
