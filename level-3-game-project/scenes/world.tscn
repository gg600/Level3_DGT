japanese_title = "運動場"
japanese_information = "運動場では、ラグビー、サッカー、陸上競技など様々なスポーツ活動が行われます。"

[node name="AstroCourts" parent="InfoPoints" unique_id=1140759791 instance=ExtResource("16_dss4m")]
transform = Transform3D(2.77836, 0, 0.34744278, 0, 2.8000002, 0, -0.34744278, 0, 2.77836, -451.19354, 19.218742, 356.51938)
